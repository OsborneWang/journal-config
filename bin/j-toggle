#!/usr/bin/env bash
# j-toggle —— 一个 fzf 界面管理今日计划（改状态 / 改名 / 删除 / 从计划外衍生待办）
#
#   回车 / 空格  切换完成状态（计划外的不受影响）
#   Ctrl-R       改名
#   Ctrl-D       删除
#   Ctrl-P       从「计划外」衍生一条待办
set -u
J="$HOME/.local/bin/j"
ACT="$HOME/.local/bin/j-act"
FZF=$(command -v fzf || echo /usr/bin/fzf)

[ -x "$FZF" ] || { echo "没装 fzf" >&2; sleep 1; exit 1; }

list() { "$J" list 2>/dev/null; }
[ -n "$(list)" ] || { echo "今天的计划是空的" >&2; sleep 1; exit 0; }

RELOAD="reload($ACT list 2>/dev/null || $J list)"

picked=$(list | "$FZF" --multi --reverse --height=100% \
	--delimiter='\t' --with-nth=3.. \
	--prompt='今日计划 › ' \
	--header='回车/空格=切换完成 · C-R=改名 · C-D=删除 · C-P=从计划外衍生待办 · q=退出' \
	--bind "space:toggle+down" \
	--bind "ctrl-r:execute($ACT rename {1} {2})+reload($J list)" \
	--bind "ctrl-d:execute($ACT delete {1} {2})+reload($J list)" \
	--bind "ctrl-p:execute($ACT promote {1} {2})+reload($J list)")

[ -z "${picked:-}" ] && exit 0

while IFS=$'\t' read -r typ idx _rest; do
	[ -n "${typ:-}" ] || continue
	"$ACT" toggle "$typ" "$idx"
done <<<"$picked"
